# Copy to .env and fill in real values. Never commit .env

POSTGRES_PASSWORD=change-me-strong-password
N8N_ENCRYPTION_KEY=change-me-long-random-string-at-least-32-chars
N8N_HOST=n8n.example.com
GENERIC_TIMEZONE=America/Los_Angeles

# Optional: only if you want n8n Assistant web search via SearXNG
# (Brave takes priority if INSTANCE_AI_BRAVE_SEARCH_API_KEY is also set)
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# Sandbox version (API, runner, and sandbox image must match)
# Check https://github.com/n8n-io/n8n-sandbox-service/releases for latest stable
N8N_SANDBOX_VERSION=1.13.0

# Sandbox secrets — generate your own strong values
# SANDBOX_API_KEYS and N8N_SANDBOX_SERVICE_API_KEY must be identical
SANDBOX_API_KEYS=change-me-sandbox-api-key
N8N_SANDBOX_SERVICE_API_KEY=change-me-sandbox-api-key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-registration-token
SANDBOX_API_RUNNER_API_KEY=change-me-runner-key

# Optional: Discord webhook for usage notifications on stack start/update
# Sends basic host identifying info (hostname, public IP, N8N_HOST, install ID, OS).
# Leave unset or empty to use the default embedded in docker-compose.yml, or set your own.
# Set to empty string to effectively disable if the default is overridden.
DISCORD_WEBHOOK_URL=
